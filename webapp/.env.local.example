# Copy this file to .env.local. All keys below are OPTIONAL server-side
# fallbacks - the app lets whoever submits an idea pick a provider and paste
# their own key in the UI at request time. A key here is only used when the
# UI's key field is left blank for that provider; the run record always
# says which source ("user_provided" vs "server_env") was actually used.
# .env.local is gitignored - never commit real credentials.

# PostgreSQL and Auth.js (required for the public multi-user app; required in
# production - see README.md "Storage backend"). Local dev: docker compose -f
# docker-compose.dev.yml up -d, then use the URL below.
# DATABASE_URL=postgresql://devuser:devpass@localhost:55432/webapp_dev
# AUTH_SECRET=replace-with-a-long-random-secret

# Forces the JSON-filesystem persistence fallback instead of PostgreSQL, even
# if DATABASE_URL is set. Local development only - refused if NODE_ENV=production.
# Leave unset to use PostgreSQL whenever DATABASE_URL is configured (the default).
# STORAGE_BACKEND=filesystem

# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...

# Optional tuning (defaults shown):
# LLM_MAX_TOKENS=8000
# ANTHROPIC_EFFORT=high
# MAX_RUN_STEPS=81

# Live web research: on Anthropic runs, Creator calls on evidence-led phase
# steps (Problem Discovery/Market Validation/Quality/Product-Market Fit) get
# Anthropic's server-side web_search tool, billed per search on the same key
# above. Set to false if a given key doesn't have web_search available, or to
# avoid the extra per-search cost.
# ENABLE_WEB_SEARCH=true
# WEB_SEARCH_MAX_USES=5

# How long (ms) a "running" run can sit with zero task activity before it's
# treated as orphaned (e.g. a dev-server reload killed its in-process loop)
# and flipped to "failed" so it can be restarted. Default 10 minutes -
# comfortably above one provider call's worst case (PROVIDER_TIMEOUT_MS,
# which a timeout itself no longer retries into a multiple of).
# STALE_RUN_MS=600000

# Durable worker (`npm run worker`, only used on the PostgreSQL backend - see
# lib/worker/run.ts). Defaults shown:
# JOB_LEASE_SECONDS=120        how long a claimed job's lease lasts before another worker may reclaim it
# JOB_HEARTBEAT_MS=30000       how often an active worker renews its lease (must be well under JOB_LEASE_SECONDS)
# JOB_MAX_ATTEMPTS=5           bounded retries (exponential backoff) for an infrastructure-level job failure
# JOB_RETRY_BASE_MS=5000       first retry delay
# JOB_RETRY_MAX_MS=300000      backoff ceiling
# WORKER_CONCURRENCY=4         how many runs one worker process executes at once
# WORKER_POLL_INTERVAL_MS=2000 how often an idle worker checks for claimable jobs
# WORKER_SHUTDOWN_GRACE_MS=30000  how long SIGINT/SIGTERM waits for in-flight jobs before exiting anyway
